{
  "name": "@whats-in-my-fridge/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:rls": "supabase test db --workdir ../..",
    "db:lint": "supabase db lint --workdir ../.. --level warning",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:env": "node scripts/check-env.mjs",
    "check:supabase": "node scripts/check-supabase-boundaries.mjs",
    "types:supabase": "supabase gen types typescript --local --workdir ../.. > src/types/database.generated.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.5",
    "jsdom": "27.2.0",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@9.15.0"
}
