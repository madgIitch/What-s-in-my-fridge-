NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy Supabase anon keys are also accepted as a fallback.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Prefer a Google service-account JSON credential in deployed environments.
GOOGLE_CLOUD_VISION_CREDENTIALS_JSON=
# API keys remain supported for simple/local setups.
GOOGLE_VISION_API_KEY=
# Use only in local/test environments. Never expose OCR text through NEXT_PUBLIC_*.
OCR_VISION_ADAPTER=
OCR_MOCK_TEXT=
