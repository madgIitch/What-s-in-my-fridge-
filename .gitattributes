# Los manifests y archivos de configuracion JSON deben permanecer como texto.
*.json text eol=lf
  
# Imágenes  
*.png filter=lfs diff=lfs merge=lfs -text  
apps/web/public/icons/*.png -filter -diff -merge -text
*.jpg filter=lfs diff=lfs merge=lfs -text  
*.jpeg filter=lfs diff=lfs merge=lfs -text  
*.gif filter=lfs diff=lfs merge=lfs -text  
*.webp filter=lfs diff=lfs merge=lfs -text  
# Videos  
*.mp4 filter=lfs diff=lfs merge=lfs -text  
*.mov filter=lfs diff=lfs merge=lfs -text  
# APKs y archivos binarios  
*.apk filter=lfs diff=lfs merge=lfs -text  
*.aab filter=lfs diff=lfs merge=lfs -text  
# Archivos de datos  
*.db filter=lfs diff=lfs merge=lfs -text  
*.sqlite filter=lfs diff=lfs merge=lfs -text
whats-in-my-fridge-backend/data/recipes*.json* filter=lfs diff=lfs merge=lfs -text
