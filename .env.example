# Browser-safe values (the NEXT_PUBLIC_ prefix exposes values to the web bundle)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vercel server runtime only
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLOUD_VISION_CREDENTIALS_JSON=

# Google Cloud media worker / queue (server-side only)
GCP_PROJECT_ID=
GCP_REGION=europe-west1
CLOUD_TASKS_QUEUE=recipe-imports
CLOUD_RUN_WORKER_URL=
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=
GCS_TEMP_BUCKET=
GCS_SIGNER_CLIENT_EMAIL=
GCS_SIGNER_PRIVATE_KEY=
CLOUD_TASKS_ENQUEUE_URL=
GCP_TASKS_PRIVATE_KEY=
WHISPER_SERVICE_URL=
OLLAMA_SERVICE_URL=
OLLAMA_RECIPE_MODEL=recipe-extractor
INTERNAL_SERVICE_TOKEN=
WORKER_OIDC_AUDIENCE=
TASKS_SERVICE_ACCOUNT_EMAIL=
RECIPE_IMPORT_ENABLED_SOURCES=youtube,instagram,tiktok,blog,manual,file
RECIPE_IMPORT_FILE_ENABLED=true
RECIPE_IMPORT_WHISPER_ENABLED=true
RECIPE_IMPORT_EXTRACTION_ENABLED=true

# Migration tooling only; never expose with NEXT_PUBLIC_
MIGRATION_FIREBASE_PROJECT_ID=
MIGRATION_FIREBASE_SERVICE_ACCOUNT_JSON=
MIGRATION_ENVIRONMENT=staging
MIGRATION_FIREBASE_USERS_FILE=
MIGRATION_FIREBASE_IMPORT_SCRIPT=
MIGRATION_FIREBASE_HASH_SIGNER_KEY=
MIGRATION_FIREBASE_HASH_SALT_SEPARATOR=
MIGRATION_FIREBASE_HASH_ROUNDS=
MIGRATION_FIREBASE_HASH_MEM_COST=
# Leave empty for dry-run. The explicit write value is documented in docs/AUTH_MIGRATION.md.
MIGRATION_CONFIRM_WRITE=

# Keep distinct values per environment. Never copy production secrets to Preview.
# Local values are emitted by `supabase status`; staging/production live in their
# respective Vercel/Supabase secret stores and are never committed.
