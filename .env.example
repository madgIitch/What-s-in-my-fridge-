# Browser-safe values (the NEXT_PUBLIC_ prefix exposes values to the web bundle)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vercel server runtime only
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLOUD_VISION_CREDENTIALS_JSON=

# Google Cloud media worker / queue (server-side only)
GCP_PROJECT_ID=
GCP_REGION=europe-west1
CLOUD_TASKS_QUEUE=recipe-imports
CLOUD_RUN_WORKER_URL=
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=
GCS_TEMP_BUCKET=

# Migration tooling only; never expose with NEXT_PUBLIC_
MIGRATION_FIREBASE_PROJECT_ID=
MIGRATION_FIREBASE_SERVICE_ACCOUNT_JSON=

# Keep distinct values per environment. Never copy production secrets to Preview.
# Local values are emitted by `supabase status`; staging/production live in their
# respective Vercel/Supabase secret stores and are never committed.
