{  
  "compilerOptions": {  
    "lib": ["es2017"],
    "module": "commonjs",  
    "noImplicitReturns": true,  
    "noUnusedLocals": true,  
    "outDir": "lib",  
    "sourceMap": true,  
    "strict": true,  
    "target": "es2017",  
    "esModuleInterop": true,  
    "resolveJsonModule": true,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"]
  },  
  "compileOnSave": true,  
  "include": [  
    "src"  
  ],  
  "exclude": [  
    "node_modules"  
  ]  
}
